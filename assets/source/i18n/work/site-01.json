 {
  "id": "77964b306b7a",
  "en": "About SMAG",
  "page": "company/about-us/index.html"
 },
 {
  "id": "80b126f1df16",
  "en": "A Mumbai magnet workshop, on production lines since 1978",
  "page": "company/about-us/index.html"
 },
 {
  "id": "d1693c0a55d7",
  "en": "We design, machine and test every unit at our own works in Dahisar, Mumbai. Nothing leaves until it has been matched to the job it is going to do. We have worked this way since 1978, for plants across India and for export.",
  "page": "company/about-us/index.html"
 },
 {
  "id": "3317604cc66c",
  "en": "{1}Every unit is sized from the application itself.{/1} Your material, your throughput and your load decide the pull, the reach and the housing we build.",
  "page": "company/about-us/index.html"
 },
 {
  "id": "e51bdc4ade3e",
  "en": "Built in-house, matched to the job",
  "page": "company/about-us/index.html"
 },
 {
  "id": "47aa0a7bf63b",
  "en": "Magnet circuits, housings and machined faces are all made here, which puts build quality and delivery dates in our own hands. Inspection and dispatch run under an ISO 9001:2015 system.",
  "page": "company/about-us/index.html"
 },
 {
  "id": "1f67bd8b58f7",
  "en": "Years after a unit ships we still carry spares for it, re-magnetise assemblies that have weakened, and service what we sold.",
  "page": "company/about-us/index.html"
 },
 {
  "id": "9f16e9749799",
  "en": "The year we started making magnets in Mumbai",
  "page": "company/about-us/index.html"
 },
 {
  "id": "cdb7083c0b44",
  "en": "ISO 9001",
  "page": "company/about-us/index.html"
 },
 {
  "id": "53d975d3fe0c",
  "en": "Quality system certified for manufacture and export",
  "page": "company/about-us/index.html"
 },
 {
  "id": "688884d44b3a",
  "en": "Average across 23 customer reviews",
  "page": "company/about-us/index.html"
 },
 {
  "id": "f3e4fadb9e37",
  "en": "Export",
  "page": "company/about-us/index.html"
 },
 {
  "id": "34ddc13577c1",
  "en": "Shipped to plants across India and overseas",
  "page": "company/about-us/index.html"
 },
 {
  "id": "d158f3e4f37d",
  "en": "How we specify a magnet",
  "page": "company/about-us/index.html"
 },
 {
  "id": "07130c87317a",
  "en": "The same three steps for one stock magnet and for a separator built around your line.",
  "page": "company/about-us/index.html"
 },
 {
  "id": "f60b4754a754",
  "en": "01. Read the application",
  "page": "company/about-us/index.html"
 },
 {
  "id": "ec346fd198bf",
  "en": "What is the material, how fast is it moving, how much room is there, and what are you trying to catch or lift.",
  "page": "company/about-us/index.html"
 },
 {
  "id": "7a77461d6e12",
  "en": "02. Match the circuit",
  "page": "company/about-us/index.html"
 },
 {
  "id": "89b5b726c505",
  "en": "Pull, reach, pole layout and housing get sized to those answers and drawn up for your line.",
  "page": "company/about-us/index.html"
 },
 {
  "id": "725fc5f97eb3",
  "en": "03. Build, test and dispatch",
  "page": "company/about-us/index.html"
 },
 {
  "id": "30a35fe8a35b",
  "en": "Made, tested and packed here. Servicing and spares later come from the same workshop.",
  "page": "company/about-us/index.html"
 },
 {
  "id": "98c25c78541e",
  "en": "What stays under our control",
  "page": "company/about-us/index.html"
 },
 {
  "id": "941a1b33dddc",
  "en": "The stages we handle on our own floor.",
  "page": "company/about-us/index.html"
 },
 {
  "id": "cab575c7452e",
  "en": "Application review",
  "page": "company/about-us/index.html"
 },
 {
  "id": "17b92fcb4d00",
  "en": "We look at the material, the load, the flow and the space you have before anything gets selected.",
  "page": "company/about-us/index.html"
 },
